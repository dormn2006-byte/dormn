# ===================================================
# DORMN BACKEND ENVIRONMENT VARIABLES CONFIGURATION
# ===================================================

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=dormn

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# WhatsApp Cloud API (Meta Developers)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_access_token

# ===================================================
# SMTP EMAIL SERVICE CONFIGURATION
# (Required for OTPs, Password Resets, Booking & Payment Emails)
# ===================================================
# For Gmail:
# 1. Enable 2-Step Verification on your Google account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Put your Gmail in SMTP_USER and the 16-char App Password in SMTP_PASS
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Optional overrides:
# SMTP_SERVICE=gmail
# SMTP_SECURE=false
# SMTP_FROM="Dormn Platform" <your_email@gmail.com>
