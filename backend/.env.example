# ===================================================
# DORMN BACKEND ENVIRONMENT VARIABLES CONFIGURATION
# ===================================================

# Database (MongoDB)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net
# Optional — defaults to "dormn" when omitted
MONGO_DB_NAME=dormn

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
# Optional — falls back to JWT_SECRET when omitted (used for AES-256-GCM field encryption)
DATA_ENCRYPTION_KEY=your_data_encryption_key_here

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ===================================================
# GROQ AI (powers the Dr.Dormn AI assistant)
# ===================================================
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key
# Tool-calling model used for chat replies
GROQ_MODEL=openai/gpt-oss-120b
# Cheap/fast model used to summarise long chats in the background
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b

# WhatsApp Cloud API (Meta Developers)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_access_token

# ===================================================
# EMAIL DELIVERY
# ===================================================
# ── Option A: Brevo transactional API (recommended) ──
# 1. Create an API key at https://app.brevo.com/settings/keys/api
# 2. Authenticate your domain at https://app.brevo.com/sender-settings/domains
#    (add the DKIM/SPF/DMARC records to your DNS). Once the domain shows
#    "Authenticated", ANY address at that domain works as a sender.
# 3. IMPORTANT: if your Brevo account has IP restriction enabled, add your
#    server's IP at https://app.brevo.com/security/authorised_ips or every
#    API call returns 401 (including from your local machine).
BREVO_API_KEY=xkeysib-xxxxxxxx
# SMTP relay key — optional, only used by the SMTP fallback (§ Option B)
BREVO_SMTP_KEY=xsmtpsib-xxxxxxxx

# Sending domain. The local part (the word before the @) is dynamic per email
# type in code — no config change needed to add a new one:
#   buildSender("bookings")  -> bookings@dormn.com
EMAIL_DOMAIN=dormn.com
# Default sender + display name. Any address on an authenticated domain works;
# free-mail senders (gmail.com, yahoo.com) are rejected by Brevo.
BREVO_SENDER_EMAIL=no-reply@dormn.com
BREVO_SENDER_NAME=Dormn
# Optional: default local part when buildSender() is called with no argument
# BREVO_SENDER_LOCAL_PART=no-reply

# ── Bulk-send protection (backend/src/utils/mailQueue.js) ──
# Emails are paced through a bounded queue so a traffic spike can't open
# hundreds of provider calls, get rate-limited, or exhaust memory.
MAIL_QUEUE_CONCURRENCY=3      # max sends in flight
MAIL_MIN_INTERVAL_MS=120      # minimum gap between send starts
MAIL_QUEUE_MAX_SIZE=5000      # max waiting tasks before new sends are dropped
BREVO_MAX_ATTEMPTS=3          # retries per email (timeout/429/5xx, with backoff)
BREVO_RETRY_BASE_MS=500       # base backoff between retries
# BREVO_API_URL=https://api.brevo.com/v3

# ── Sending API ──
# Generic entry point — sender, recipient(s), content and more:
#   import { sendMail, sendBulkMail, buildSender } from "./utils/emailService.js";
#   await sendMail({
#     from: "receipts",           // local part, full address, or { name, email }
#     to: "student@example.com",  // string or array; cc / bcc work the same way
#     subject: "Your receipt",
#     html: "<h1>Paid</h1>",
#     // text, cc, bcc, replyTo, attachments, headers, tags, senderName
#   });
#   await sendBulkMail([{ to, subject, html }, ...]);   // bounded concurrency
# Legacy signature still works: sendEmail(to, subject, html, "bookings@dormn.com")

# ── Option B: SMTP (used only when BREVO_API_KEY is absent) ──
# Brevo relay (reuses BREVO_SMTP_KEY — no need to repeat the password):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=your-brevo-account-login@example.com
#   # SMTP_PASS defaults to BREVO_SMTP_KEY
#
# For Gmail:
# 1. Enable 2-Step Verification on your Google account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Put your Gmail in SMTP_USER and the 16-char App Password in SMTP_PASS
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Optional overrides:
# SMTP_SERVICE=gmail
# SMTP_SECURE=false
# SMTP_FROM="Dormn Platform" <your_email@gmail.com>

# Send a test + run a delivery diagnostic:
#   node src/scripts/testEmail.js you@example.com
#   node src/scripts/testEmail.js you@example.com --bulk 10   # queue/bulk test

# ===================================================
# SEEDED ADMIN ACCOUNTS (used by `npm run seed`)
# ===================================================
# SUPERADMIN_EMAIL=superadmin@dormn.com
# SUPERADMIN_PASSWORD=SuperAdmin@Dormn2026
# EVENT_ADMIN_EMAIL=events@dormn.com
# EVENT_ADMIN_PASSWORD=EventManager@Dormn2026
